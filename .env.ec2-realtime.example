# ==============================================================================
# OpenSpace EC2 Instance #2: Realtime Messaging & Stream Processing (Chat & WS)
# ==============================================================================
# Copy to .env on EC2 Instance #2:
#   cp .env.ec2-realtime.example .env
# ==============================================================================

NODE_ENV=production

# ─── 1. SHARED GATEWAY AUTH ──────────────────────────────────────────────────
# Must match the GATEWAY_INTERNAL_SECRET configured on EC2 #1 exactly
# Requests without this secret in x-gateway-secret header will be rejected with 403
GATEWAY_INTERNAL_SECRET=replace_with_exact_same_gateway_secret_as_ec2_1

# ─── 2. FRONTEND ALLOWED ORIGIN ──────────────────────────────────────────────
# Used for CORS allowlisting on chat-service
WEB_APP_URL=https://openspace.yourdomain.com

# ─── 3. MANAGED DATABASES (NEON & UPSTASH) ──────────────────────────────────
# Neon PostgreSQL (Chat service StreamWorker writes messages directly to DB)
DATABASE_URL=postgresql://user:password@ep-your-project-pooler.us-east-1.aws.neon.tech/openspace?sslmode=require

# Upstash Redis (Used for Redis Pub/Sub, Redis Streams & DLQ between Chat & WS)
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# ─── 4. NODE IDENTIFIER ──────────────────────────────────────────────────────
# Name identifier stamped on WebSocket presence / node metrics
INSTANCE_NAME=ws-node-1