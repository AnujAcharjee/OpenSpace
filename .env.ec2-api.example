# ==============================================================================
# OpenSpace EC2 Instance #1: Ingress, API Gateway & HTTP/Auth Service
# ==============================================================================
# Copy to .env on EC2 Instance #1:
#   cp .env.ec2-api.example .env
# ==============================================================================

NODE_ENV=production

# ─── 1. DOMAIN & CADDY REVERSE PROXY ─────────────────────────────────────────
# The public domain pointing to EC2 #1's Elastic IP (DNS A Record)
API_DOMAIN=api.openspace.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# ─── 2. EC2 #2 (REALTIME INSTANCE) TARGETS ────────────────────────────────────
# Private IP of your second EC2 instance inside the AWS VPC (Security Group allows 3000 & 3002)
# Example: http://10.0.1.50:3000 and ws://10.0.1.50:3002
REALTIME_SERVER_CHAT_URL=http://<EC2_2_PRIVATE_IP>:3000
REALTIME_SERVER_WS_URL=ws://<EC2_2_PRIVATE_IP>:3002

# ─── 3. FRONTEND CONFIGURATION & COOKIES ─────────────────────────────────────
# Vercel deployment URL or custom domain
WEB_APP_URL=https://openspace.yourdomain.com

# Use '.yourdomain.com' if frontend and api share root domain, or leave blank if separate
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_COOKIE_NAME=accessToken

# ─── 4. SHARED SECRETS ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret
GATEWAY_INTERNAL_SECRET=replace_with_another_secure_random_hex_secret

# ─── 5. MANAGED DATABASES (NEON & UPSTASH) ──────────────────────────────────
# Neon PostgreSQL (use pooled connection URL with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-your-project-pooler.us-east-1.aws.neon.tech/openspace?sslmode=require

# Upstash Redis (use rediss:// protocol for TLS enabled connection)
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# ─── 6. PRAMAAN OAUTH ────────────────────────────────────────────────────────
PRAMAAN_CLIENT_ID=your_pramaan_client_id
PRAMAAN_SECRET=your_pramaan_client_secret
PRAMAAN_SERVER_URL=https://pramaan.yourdomain.com
CALLBACK_URL=https://api.openspace.yourdomain.com/api/v1/auth/pramaan/callback
