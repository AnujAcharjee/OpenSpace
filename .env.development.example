# Environment configuration for local development with Docker
NODE_ENV=development

# Postgres Container Configuration & Prisma URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=collab
DATABASE_URL="postgresql://postgres:password@localhost:5432/collab?schema=public"

# Local Redis Configuration
REDIS_URL="redis://localhost:6379"

# Shared JWT Secret & Auth
JWT_SECRET=collab-local-dev-jwt-secret
ACCESS_TOKEN_COOKIE_NAME=accessToken
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
GATEWAY_INTERNAL_SECRET=collab-local-gateway-internal-secret

# OAuth / Pramaan Configuration
PRAMAAN_CLIENT_ID=your-pramaan-client-id
PRAMAAN_CLIENT_SECRET=your-pramaan-client-secret
PRAMAAN_SERVER_URL=https://pramaan.anujacharjee.com
CALLBACK_URL=http://localhost:3005/api/v1/auth/pramaan/callback

# Service URLs
WEB_APP_URL=http://localhost:3004
API_GATEWAY_URL=http://localhost:3005
HTTP_SERVICE_URL=http://localhost:3003
HTTP_SERVICE_URLS=http://127.0.0.1:3003
CHAT_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_URLS=http://127.0.0.1:3001
WS_SERVICE_URL=http://localhost:3002
WS_SERVICE_URLS=http://127.0.0.1:3002
