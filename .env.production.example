# ==============================================================================
# OpenSpace Production Environment Variables Reference
# ==============================================================================
# Copy this file to .env on your production host (e.g. EC2 / VPS)
# Command: cp .env.production.example .env
#
# NOTE: Secrets should be generated securely using:
#   openssl rand -hex 32
# ==============================================================================

NODE_ENV=production

# ─── 1. DOMAIN & CADDY REVERSE PROXY ─────────────────────────────────────────
# The public domain pointing to your EC2 / VPS where Caddy will provision SSL
# Example: api.openspace.yourdomain.com
API_DOMAIN=api.openspace.example.com

# Contact email for Let's Encrypt automated SSL certificate issuance
ACME_EMAIL=admin@example.com

# ─── 2. FRONTEND APPLICATION & COOKIE CONFIGURATION ──────────────────────────
# The URL of your web frontend (e.g., your Vercel deployment URL or custom domain)
# Used for CORS allowlisting and OAuth redirection
WEB_APP_URL=https://openspace.example.com

# Cookie domain for auth token:
# - Use '.yourdomain.com' if frontend is on app.yourdomain.com and backend is on api.yourdomain.com
# - Leave BLANK if frontend and backend are on completely different domains (e.g. vercel.app & ec2-ip)
COOKIE_DOMAIN=

# Cookie SameSite policy:
# - 'lax': Recommended when frontend and backend share the parent domain
# - 'none': Required if frontend and backend are on different domains (MUST be HTTPS)
COOKIE_SAME_SITE=lax

# Cookie name used for JWT access tokens
ACCESS_TOKEN_COOKIE_NAME=accessToken

# ─── 3. APPLICATION SECRETS ──────────────────────────────────────────────────
# Secret key used to sign and verify user JWTs (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret

# Secret shared between API Gateway and downstream microservices (http, chat, ws)
# Injected into x-gateway-secret header by API Gateway to block direct unauthenticated access
GATEWAY_INTERNAL_SECRET=replace_with_another_secure_random_hex_secret

# ─── 4. DATABASES & STORAGE ──────────────────────────────────────────────────
# Option A: Self-Hosted in Docker (using docker-compose.self-hosted.yml)
# Set POSTGRES_PASSWORD and leave DATABASE_URL / REDIS_URL default
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=openspace

# Option B: Managed / Cloud Databases (Neon, Supabase, AWS RDS, Upstash)
# DATABASE_URL=postgresql://user:password@ep-sample-123.us-east-1.aws.neon.tech/openspace?sslmode=require
# REDIS_URL=rediss://default:password@sample-redis.upstash.io:6379

# ─── 5. PRAMAAN OAUTH PROVIDER ───────────────────────────────────────────────
# Pramaan Authentication Server credentials
PRAMAAN_CLIENT_ID=your_pramaan_client_id
PRAMAAN_SECRET=your_pramaan_client_secret
PRAMAAN_SERVER_URL=https://pramaan.example.com

# OAuth Callback URL (Must point to API Gateway's callback endpoint)
CALLBACK_URL=https://api.openspace.example.com/api/v1/auth/pramaan/callback
