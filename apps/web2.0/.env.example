# ==============================================================================
# OpenSpace Web 2.0 - Environment Variables Template
# ==============================================================================

# ─── 1. LOCAL DEVELOPMENT CONFIGURATION (Default) ─────────────────────────────
# In local development, services run locally via Docker or Turbo:
# - API Gateway: port 3005 (proxies to http-service:3001 and chat-service:3000)
# - WS Service: port 3002 (or proxied via API Gateway at port 3005/ws)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3005
API_GATEWAY_URL=http://localhost:3005
NEXT_PUBLIC_WS_SRV_URL=ws://localhost:3002

# ─── 2. PRODUCTION / VERCEL DEPLOYMENT CONFIGURATION ──────────────────────────
# Set these in Vercel Project Settings -> Environment Variables:
# NEXT_PUBLIC_API_GATEWAY_URL=https://api.openspace.anujacharjee.com
# API_GATEWAY_URL=https://api.openspace.anujacharjee.com
# NEXT_PUBLIC_WS_SRV_URL=wss://api.openspace.anujacharjee.com/ws

# ─── 3. CLOUDINARY MEDIA UPLOADS (Client-side Direct Uploads) ─────────────────
# Used for avatar uploads and chat message attachments:
NEXT_PUBLIC_CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=openspace_avatars
