NODE_ENV=development
PORT=3005
WEB_APP_URL=http://localhost:3000

# Auth configuration
JWT_SECRET=collab-local-dev-jwt-secret
ACCESS_TOKEN_COOKIE_NAME=accessToken

# Redis
REDIS_URL="redis://default:password@localhost:6379"

# Pramaan OAuth / Auth Provider (optional/if used)
PRAMAAN_SERVER_URL=https://pramaan.example.com
PRAMAAN_CLIENT_ID=your-client-id
PRAMAAN_CLIENT_SECRET=your-client-secret

# Internal Gateway Secret
GATEWAY_INTERNAL_SECRET=dev_gateway_secret_change_me

# Microservice Target URLs
HTTP_SERVICE_URL=http://127.0.0.1:3003
HTTP_SERVICE_URLS=http://127.0.0.1:3003

CHAT_SERVICE_URL=http://127.0.0.1:3001
CHAT_SERVICE_URLS=http://127.0.0.1:3001

WS_SERVICE_URL=http://127.0.0.1:3002
WS_SERVICE_URLS=http://127.0.0.1:3002
