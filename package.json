{
  "name": "collab",
  "description": "A multilangual collaboration application",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "cross-env ENV_TARGET=local turbo run dev",
    "dev:local": "cross-env ENV_TARGET=local turbo run dev",
    "dev:cloud": "cross-env ENV_TARGET=cloud turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.7.4",
    "turbo": "^2.8.17",
    "typescript": "5.9.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  }
}