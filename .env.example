# Root Monorepo Environment Variables Template
NODE_ENV=development

# Infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/collab
REDIS_URL="redis://localhost:6379"

# Shared Auth & Secrets
JWT_SECRET=your-secure-jwt-secret-here
ACCESS_TOKEN_COOKIE_NAME=accessToken
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
GATEWAY_INTERNAL_SECRET=dev_gateway_secret_change_me

# OAuth / Pramaan Configuration
PRAMAAN_CLIENT_ID=your-client-id
PRAMAAN_SECRET=your-client-secret
PRAMAAN_SERVER_URL=https://pramaan.example.com

# Service URLs
WEB_APP_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:3005
HTTP_SERVICE_URL=http://localhost:3003
HTTP_SERVICE_URLS=http://127.0.0.1:3003
CHAT_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_URLS=http://127.0.0.1:3001
WS_SERVICE_URL=http://localhost:3002
WS_SERVICE_URLS=http://127.0.0.1:3002
CALLBACK_URL=http://localhost:3005/api/v1/auth/pramaan/callback
