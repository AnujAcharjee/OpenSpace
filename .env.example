# Root Monorepo Cloud / Production Environment Template (.env)
NODE_ENV=production

# Infrastructure (Cloud Neon PostgreSQL & Upstash Redis)
DATABASE_URL=postgresql://username:password@ep-sample-project-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
REDIS_URL=rediss://default:password@sample-project.upstash.io:6379

# Shared Auth & Secrets
JWT_SECRET=your-secure-production-jwt-secret
ACCESS_TOKEN_COOKIE_NAME=accessToken
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
GATEWAY_INTERNAL_SECRET=your-secure-internal-gateway-secret

# OAuth / Pramaan Configuration
PRAMAAN_CLIENT_ID=your-pramaan-client-id
PRAMAAN_CLIENT_SECRET=your-pramaan-client-secret
PRAMAAN_SERVER_URL=https://pramaan.anujacharjee.com

# Service URLs
WEB_APP_URL=https://openspace.anujacharjee.com
API_GATEWAY_URL=https://api.openspace.anujacharjee.com
HTTP_SERVICE_URL=http://localhost:3003
HTTP_SERVICE_URLS=http://127.0.0.1:3003
CHAT_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_URLS=http://127.0.0.1:3001
WS_SERVICE_URL=http://localhost:3002
WS_SERVICE_URLS=http://127.0.0.1:3002
CALLBACK_URL=https://api.openspace.anujacharjee.com/api/v1/auth/pramaan/callback
